#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
timezone: UTC
manage_etc_hosts: true
growpart:
  mode: auto
  devices: ["/"]
  ignore_growroot_disabled: false
resize_rootfs: true
swap:
  size: 0
package_update: true
package_upgrade: false
packages:
  - qemu-guest-agent
  - openssh-server
  - ca-certificates
  - curl
  - gnupg
  - chrony
users:
  - default
  - name: ${ssh_username}
    groups:
      - sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - ${key}
%{ endfor ~}
write_files:
  # Port 22 belongs to gitlab-sshd behind HAProxy; admin OpenSSH listens here.
  - path: /etc/ssh/sshd_config.d/91-ansible-listen.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port ${ssh_port}
runcmd:
  - systemctl daemon-reload
  - systemctl restart ssh.socket
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now chrony
  - touch /var/lib/cloud/instance/gitlab-cloud-init.done
