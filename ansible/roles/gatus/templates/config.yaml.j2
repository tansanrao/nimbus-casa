---
metrics: true

storage:
  type: sqlite
  caching: true
  path: /data/gatus.db

ui:
  title: Nimbus Casa Edge
  header: Nimbus Casa Edge

web:
  address: {{ gatus_web_address }}
  port: {{ gatus_web_port }}
{% if gatus_pushover_user_key is defined %}

alerting:
  pushover:
    application-token: {{ gatus_pushover_application_token | to_json }}
    user-key: {{ gatus_pushover_user_key | to_json }}
    priority: 1
    resolved-priority: 0
    default-alert:
      failure-threshold: 1
      success-threshold: 1
      send-on-resolved: true
{% endif %}
{% if gatus_heartbeat_endpoints %}

# Pushed to by Alertmanager's always-firing Watchdog alert. Gatus records a
# failure, and pages, when no push arrives within the interval.
external-endpoints:
{% for endpoint in gatus_heartbeat_endpoints %}
  - name: {{ endpoint.name }}
    group: {{ endpoint.group }}
    token: {{ gatus_heartbeat_token | to_json }}
    heartbeat:
      interval: {{ endpoint.interval }}
    alerts:
      - type: pushover
        description: {{ endpoint.description | to_json }}
{% endfor %}
{% endif %}

endpoints:
  - name: HAProxy local health
    group: edge
    url: http://{{ haproxy_health_bind }}/
    interval: 1m
    conditions:
      - "[STATUS] == 200"
{% if gatus_enable_connector_checks %}
  - name: WireGuard connector peer
    group: edge
    url: icmp://{{ wireguard_connector_address | regex_replace('/.*$', '') }}
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
  - name: Connector HAProxy
    group: edge
    url: tcp://{{ connector_haproxy_backend }}
    interval: 1m
    conditions:
      - "[CONNECTED] == true"
{% endif %}
{% for endpoint in gatus_public_endpoints %}
  - name: {{ endpoint.name }}
    group: public
    url: {{ endpoint.url }}
    interval: {{ endpoint.interval | default('1m') }}
    conditions:
      - "[STATUS] >= 200"
      - "[STATUS] < 400"
{% endfor %}
