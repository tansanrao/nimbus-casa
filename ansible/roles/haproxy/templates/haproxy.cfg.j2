global
  log /dev/log local0
  log /dev/log local1 notice
  chroot /var/lib/haproxy
  stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
  stats timeout 30s
  user haproxy
  group haproxy
  daemon

defaults
  log global
  option dontlognull
  timeout connect {{ haproxy_connect_timeout }}
  timeout client {{ haproxy_client_timeout }}
  timeout server {{ haproxy_server_timeout }}

{% if haproxy_role == 'edge' %}
frontend fe_http
  bind :::80 v4v6
  mode http
  option httplog
{% if haproxy_acme_http01 %}
  acl acme_host hdr(host) -i {{ haproxy_acme_http01.hostnames | join(' ') }}
  acl acme_challenge path_beg /.well-known/acme-challenge/
  http-request redirect scheme https code 301 unless acme_host acme_challenge
  use_backend be_acme_http01 if acme_host acme_challenge
{% else %}
  http-request redirect scheme https code 301
{% endif %}
{% if haproxy_acme_http01 %}

# Let's Encrypt HTTP-01 challenges for these hosts, answered by certbot's
# standalone server, which only listens while it issues or renews.
backend be_acme_http01
  mode http
  server certbot {{ haproxy_acme_http01.backend }}
{% endif %}

frontend fe_https
  bind :::443 v4v6
  mode tcp
  option tcplog
  tcp-request inspect-delay 5s
  tcp-request content accept if { req_ssl_hello_type 1 }
{% set kubernetes_acl_names = [] %}
{% for domain in haproxy_kubernetes_domains %}
{% set acl_name = 'sni_kubernetes_' ~ loop.index %}
{% set _ = kubernetes_acl_names.append(acl_name) %}
{% if domain.startswith('.') %}
  acl {{ acl_name }} req.ssl_sni -m end {{ domain }}
{% else %}
  acl {{ acl_name }} req.ssl_sni -i {{ domain }}
{% endif %}
{% endfor %}
{% if haproxy_gatus_push %}
  acl sni_gatus_push req.ssl_sni -i {{ [haproxy_gatus_push.hostname, haproxy_gatus_push.ui_hostname | default('')] | select | join(' ') }}
  use_backend be_gatus_push if sni_gatus_push
{% endif %}
  use_backend be_kubernetes_tls if {{ kubernetes_acl_names | join(' || ') }}
  default_backend be_kubernetes_tls

backend be_kubernetes_tls
  mode tcp
  option tcp-check
  server connector {{ connector_haproxy_backend }} check send-proxy-v2 check-send-proxy

{% if haproxy_gatus_push %}
# Gatus behind TLS that ends here. Heartbeat pushes may POST to the external
# endpoint API, which still checks the bearer token. With ui_hostname set,
# GET and HEAD requests for that host reach the read-only UI, except Gatus's
# /metrics. Everything else gets 403.
backend be_gatus_push
  mode tcp
  server push {{ haproxy_gatus_push.bind }} send-proxy-v2

listen gatus_push
  bind {{ haproxy_gatus_push.bind }} accept-proxy ssl crt {{ haproxy_gatus_push.certificate }} alpn http/1.1
  mode http
  option httplog
  timeout http-request 10s
  http-request allow if METH_POST { path -m reg ^/api/v1/endpoints/[^/]+/external$ }
{% if haproxy_gatus_push.ui_hostname | default('') %}
  http-request allow if METH_GET { hdr(host),field(1,:) -i {{ haproxy_gatus_push.ui_hostname }} } !{ path_beg -i /metrics }
{% endif %}
  http-request deny deny_status 403
  server gatus {{ haproxy_gatus_push.backend }}

{% endif %}
{% elif haproxy_role == 'connector' %}
frontend fe_connector_tls
  bind {{ haproxy_connector_bind }} accept-proxy
  mode tcp
  option tcplog
  default_backend be_envoy_external_tls

backend be_envoy_external_tls
  mode tcp
  option tcp-check
  server envoy_external {{ haproxy_envoy_external_backend }} check send-proxy-v2 check-send-proxy

{% endif %}
{% for forward in haproxy_tcp_forwards %}
frontend fe_{{ forward.name }}
  bind {{ forward.bind }}{% if forward.accept_proxy | default(false) %} accept-proxy{% endif %}

  mode tcp
  option tcplog
{% if forward.timeout is defined %}
  timeout client {{ forward.timeout }}
{% endif %}
{% for line in forward.frontend_lines | default([]) %}
  {{ line }}
{% endfor %}
  default_backend be_{{ forward.name }}

backend be_{{ forward.name }}
  mode tcp
{% if forward.timeout is defined %}
  timeout server {{ forward.timeout }}
  timeout tunnel {{ forward.timeout }}
{% endif %}
  server {{ forward.name }} {{ forward.backend }} check{% if forward.send_proxy | default(false) %} send-proxy-v2 check-send-proxy{% endif %}


{% endfor %}

listen local_health
  bind {{ haproxy_health_bind }}
  mode http
  http-request return status 200 content-type text/plain string "ok\n"
